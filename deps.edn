{:paths ["src" "test"]

 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        org.clojure/clojurescript {:mvn/version "1.10.773"}
        org.clojure/tools.logging {:mvn/version "1.2.4"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.921"}
        com.taoensso/timbre {:mvn/version "6.4.0"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.87.1389"}
                      lambdaisland/kaocha-cloverage {:mvn/version "1.1.137"}}
         :main-opts ["-m" "kaocha.runner"]}

  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.05.24"}}
         :main-opts ["-m" "clj-kondo.core" "--lint" "src" "test"]}

  :run {:main-opts ["-m" "venueadminops.sim"]}

  :nbb {:deps {applied-science/js {:git/url "https://github.com/applied-science/js.git"
                                   :git/sha "9d5a9e8b5d4e"
                                   :git/tag "v0.2.6"}}}}}
